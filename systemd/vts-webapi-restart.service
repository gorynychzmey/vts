[Unit]
Description=Restart only the VTS web API container inside the vts pod
Documentation=man:podman-restart(1)
# Same reasoning as vts-worker-restart.service: Requisite=, so this never starts
# the pod as a side effect.
After=vts.service
Requisite=vts.service

[Service]
Type=oneshot
RemainAfterExit=no
# Without this systemd reaps the whole cgroup once ExecStart returns — and
# `podman restart` leaves the RESTARTED container's conmon inside that cgroup.
# Measured the hard way: the unit killed the very container it had just brought
# back, taking the service down and leaving the pod Degraded, while reporting a
# timeout failure. KillMode=none makes systemd leave those processes alone; this
# unit only issues a command, it does not own the container.
KillMode=none
# Restarting one container leaves its neighbour untouched and the pod Running (verified on podman 5.7.0): an in-flight transcription in vts-worker keeps running.
ExecStart=/usr/bin/podman restart vts-webapi
